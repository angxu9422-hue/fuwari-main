---
import PostPage from "../components/PostPage.astro";
import Pagination from "../components/control/Pagination.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";

// SSR mode: manually compute pagination since getStaticPaths is ignored
const allBlogPosts = await getSortedPosts();
const total = allBlogPosts.length;
const lastPage = Math.ceil(total / PAGE_SIZE);

const pageParam = Astro.params.page;
let currentPage = pageParam ? parseInt(pageParam) : 1;
if (isNaN(currentPage) || currentPage < 1) currentPage = 1;
if (currentPage > lastPage && lastPage > 0) currentPage = lastPage;

const start = (currentPage - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;
const pageData = allBlogPosts.slice(start, end);

const page = {
	data: pageData,
	start,
	end: Math.min(end, total),
	total,
	size: PAGE_SIZE,
	currentPage,
	lastPage,
	url: {
		current: currentPage === 1 ? "/" : `/${currentPage}/`,
		next: currentPage < lastPage ? `/${currentPage + 1}/` : undefined,
		prev: currentPage > 1 ? (currentPage === 2 ? "/" : `/${currentPage - 1}/`) : undefined,
	},
};

const len = page.data.length;
---

<MainGridLayout title={page.currentPage === 1 ? undefined : `第 ${page.currentPage} 页`}>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style=`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`></Pagination>
</MainGridLayout>